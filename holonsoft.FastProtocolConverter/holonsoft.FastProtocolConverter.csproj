<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <Title>FastProtocolConverter by holonsoft</Title>
    <Description>Fast binary protocol converter: describe a frame with attributes on a POCO and convert raw bytes, for example from a hardware device or a socket, into an instance and back. Compiled accessors instead of reflection, so a 38 byte frame reads in 59 ns and writes in 56 ns, and nothing at all is allocated per message when you read into an instance you keep and write into a buffer you own. Little and big endian at the same speed, fields and properties, ReadOnlySpan and IBufferWriter overloads.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="holonsoft.FluentConditions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\holonsoft.FastProtocolConverter.Abstractions\holonsoft.FastProtocolConverter.Abstractions.csproj" />
  </ItemGroup>

</Project>
