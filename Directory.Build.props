<Project>

  <PropertyGroup Label="Target frameworks">
    <!-- Shared list for the packable libraries. Projects with other needs (tests, benchmarks) set their own. -->
    <LibraryTargetFrameworks>net8.0;net9.0;net10.0</LibraryTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Label="Compiler">
    <!-- No LangVersion override on purpose: each target framework uses its default C# version.
         Forcing C# 14 onto net8.0/net9.0 breaks the target-typed conditionals in
         ProtocolConverterToByteArray (CS1503), which only resolve against the net10.0 BCL. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Company>holonsoft</Company>
    <Authors>Alexander Bülow, Christian Vogt</Authors>
    <Copyright>Alexander Bülow, Christian Vogt, holonsoft</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/holonsoft/FastProtocolConverter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/holonsoft/FastProtocolConverter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>protocol;converter;serialization;deserialization;binary;bytes;marshalling;hardware;poco</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="Package build">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup Label="Versioning">
    <!-- MinVer derives the version from git tags (v4.0.0). Untagged commits become 4.0.0-preview.0.N. -->
    <!-- A tag on the current commit always wins, even below the minimum, so a v3.6.x tag would be honored too. -->
    <!-- The floor is 4.0 because main already carries breaking changes: short frames throw -->
    <!-- ProtocolConverterException instead of ArgumentOutOfRangeException, range attributes are parsed -->
    <!-- with the invariant culture, the big endian Guid format changed and overlap detection is stricter. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>4.0</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
